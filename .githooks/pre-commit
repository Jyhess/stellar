#!/bin/sh
# Refuse the commit if the verification fails. Never bypass it with --no-verify.
# GPU tests are left out (slow, and they hang when they share the card in
# parallel); run them before handing over:
#   cargo test -p stellar-engine-gpu -- --test-threads=1
set -e
cd "$(git rev-parse --show-toplevel)"
cargo test --workspace --exclude stellar-engine-gpu && cargo clippy --workspace --all-targets -- -D warnings
